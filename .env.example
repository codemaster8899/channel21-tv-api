# Copy to .env for local development
DB_URL=mongodb://127.0.0.1:27017/21tv
LOCAL_PORT=5000
CORS_DOMAIN=http://localhost:3000,http://localhost:3001
JWT_PRIVATE_KEY=local-dev-secret-21tv

# Optional: override image URLs in seed (defaults to https://21-back.vercel.app)
# SEED_IMAGE_BASE=https://21-back.vercel.app

# Set to true on Vercel to auto-seed DB on each deploy
# SEED_ON_DEPLOY=true
